{
  "everos-antigravity": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node \"../../../hooks/scripts/session-start.js\"",
        "timeout": 15
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node \"../../../hooks/scripts/recall.js\"",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node \"../../../hooks/scripts/capture.js\"",
        "timeout": 30
      }
    ]
  }
}
